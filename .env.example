OPENAI_API_KEY=
OPENAI_PHOTO_CHECK_MODEL=gpt-5-nano
OPENAI_VISION_MODEL=
OPENAI_TRENDS_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
RATE_LIMIT_SECRET=
ANALYSIS_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this secret through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Local development/test only. Never enables mock billing in production or on Vercel.
SUBSCRIPTION_MOCK_ENABLED=false
# ECPay stays disabled until migrations, merchant approval and deployment checks pass.
ECPAY_ENABLED=false
ECPAY_ENV=stage
# stage: public test credentials in .ecpay-skill/AGENTS.md.
# production: configure real credentials only in the deployment platform server environment.
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# Public HTTPS origin without a path; production: https://stylecue.website
ECPAY_PUBLIC_BASE_URL=
